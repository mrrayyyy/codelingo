# Configure these on Render, not on your personal computer.
# Neon: change postgresql:// to postgresql+psycopg:// and retain ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# Neon direct connection (host without -pooler), used only for schema migrations at startup.
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DIRECT-HOST/DB?sslmode=require
API_KEY=generate-a-separate-secret-at-least-32-characters
WORKSPACE_PASSWORD=choose-a-password-at-least-16-characters
GITHUB_ACTIONS_TOKEN=your-fine-grained-token-with-actions-write
GITHUB_ACTIONS_REPO=your-github-user/your-codelingo-app-repo
GITHUB_ACTIONS_REF=main
JOB_MODE=github_actions
TIMEZONE=Asia/Ho_Chi_Minh
DICTIONARY_ONLINE=false
TTS_PROVIDER=groq
STT_PROVIDER=groq
LLM_PROVIDER=groq
# Optional: blank keeps speech/writing disabled. No local models are installed.
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_VOICE=troy
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
